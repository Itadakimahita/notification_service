 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "panels": [
  {
   "type": "row",
   "title": "Overview",
   "id": 1,
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "type": "stat",
   "title": "Accept rate",
   "id": 2,
   "description": "Notifications accepted per second by the API.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "area"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(http_request_duration_seconds_count{job=\"api\",route=\"/v1/notifications\",method=\"POST\",status=\"202\"}[$__rate_interval]))",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "type": "stat",
   "title": "Enqueue p95",
   "id": 3,
   "description": "Target: below 100 ms.",
