     "placement": "bottom",
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (channel, result) (rate(worker_send_total[1m]))",
     "legendFormat": "{{channel}} {{result}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "id": 4
  },
  {
