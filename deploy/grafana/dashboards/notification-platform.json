    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, channel) (rate(worker_send_seconds_bucket[1m])))",
     "legendFormat": "{{channel}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "id": 5
  },
  {
   "type": "timeseries",
